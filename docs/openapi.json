{
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "considered_move_uci": {
            "anyOf": [
              {
                "maxLength": 5,
                "minLength": 4,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Considered Move Uci"
          },
          "fen": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Fen",
            "type": "string"
          },
          "mode": {
            "$ref": "#/components/schemas/Workflow"
          },
          "rating_bucket": {
            "$ref": "#/components/schemas/RatingBucket",
            "default": "1400-1599"
          }
        },
        "required": [
          "mode",
          "fen"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "BoardMoveRequest": {
        "additionalProperties": false,
        "properties": {
          "difficulty": {
            "$ref": "#/components/schemas/GameDifficulty",
            "default": "club"
          },
          "engine_reply": {
            "default": false,
            "title": "Engine Reply",
            "type": "boolean"
          },
          "fen": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Fen",
            "type": "string"
          },
          "move_uci": {
            "maxLength": 5,
            "minLength": 4,
            "title": "Move Uci",
            "type": "string"
          }
        },
        "required": [
          "fen",
          "move_uci"
        ],
        "title": "BoardMoveRequest",
        "type": "object"
      },
      "EngineTurnRequest": {
        "additionalProperties": false,
        "properties": {
          "difficulty": {
            "$ref": "#/components/schemas/GameDifficulty",
            "default": "club"
          },
          "fen": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Fen",
            "type": "string"
          }
        },
        "required": [
          "fen"
        ],
        "title": "EngineTurnRequest",
        "type": "object"
      },
      "GameDifficulty": {
        "enum": [
          "casual",
          "club",
          "strong"
        ],
        "title": "GameDifficulty",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LegalMovesRequest": {
        "additionalProperties": false,
        "properties": {
          "fen": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Fen",
            "type": "string"
          },
          "from_square": {
            "pattern": "^[a-h][1-8]$",
            "title": "From Square",
            "type": "string"
          }
        },
        "required": [
          "fen",
          "from_square"
        ],
        "title": "LegalMovesRequest",
        "type": "object"
      },
      "RatingBucket": {
        "enum": [
          "1000-1199",
          "1200-1399",
          "1400-1599",
          "1600-1800"
        ],
        "title": "RatingBucket",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "Workflow": {
        "enum": [
          "position",
          "compare"
        ],
        "title": "Workflow",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "GemmaFischer local API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analyses": {
